# Code style for the Counter API.
#
# Article IV of the constitution is enforced here as build severities rather
# than left to review: a naming rule that only a reviewer applies is a rule that
# stops applying the moment someone is in a hurry.

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,md}]
indent_size = 2

[*.cs]
max_line_length = 110

# --- Article IV: self-documenting names --------------------------------------

dotnet_naming_rule.types_are_pascal_case.severity = error
dotnet_naming_rule.types_are_pascal_case.symbols = type_symbols
dotnet_naming_rule.types_are_pascal_case.style = pascal_case
dotnet_naming_symbols.type_symbols.applicable_kinds = class,struct,interface,enum,delegate
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.members_are_pascal_case.severity = error
dotnet_naming_rule.members_are_pascal_case.symbols = member_symbols
dotnet_naming_rule.members_are_pascal_case.style = pascal_case
dotnet_naming_symbols.member_symbols.applicable_kinds = method,property,event

dotnet_naming_rule.interfaces_start_with_i.severity = error
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = prefixed_with_i
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefixed_with_i.required_prefix = I
dotnet_naming_style.prefixed_with_i.capitalization = pascal_case

dotnet_naming_rule.private_fields_have_underscore.severity = error
dotnet_naming_rule.private_fields_have_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_have_underscore.style = underscore_camel_case
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# --- Clarity over brevity ----------------------------------------------------

# `var` hides the type at the point a reader most wants it.
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = false:warning

# Guard clauses over deep nesting.
csharp_style_prefer_pattern_matching = true:suggestion
dotnet_diagnostic.IDE0046.severity = none

# Unused code is a question a reader has to answer.
dotnet_diagnostic.IDE0051.severity = error
dotnet_diagnostic.IDE0052.severity = error
dotnet_diagnostic.CS0168.severity = error

# Documentation on public surfaces (Article IV).
dotnet_diagnostic.CS1591.severity = warning

# --- Correctness -------------------------------------------------------------

# Nullable warnings are errors: a null reference at a counter is a blank screen
# during a customer call.
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8604.severity = error
dotnet_diagnostic.CS8618.severity = error

# A blanket catch hides the failure the operator needs to see.
dotnet_diagnostic.CA1031.severity = warning

# Cancellation tokens must be passed through: FR-033 depends on a timeout
# actually stopping the work rather than only abandoning the wait.
dotnet_diagnostic.CA2016.severity = error
