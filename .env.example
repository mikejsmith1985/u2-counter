# Connection settings for the MCP server.
#
# The demonstration runs with U2_DRIVER=demo, which reads the MultiValue store in
# mvstore/data and never opens a database connection. The four U2_* settings below
# still have to be present, because the server validates its configuration at
# startup whichever driver is loaded — but with the demo driver they are
# placeholders and nothing authenticates against them.
#
# A real deployment points U2_DRIVER at uopy and supplies real values through the
# vault. Never commit a real password here; .env itself is ignored for that reason.

U2_DRIVER=demo
U2_HOST=127.0.0.1
U2_USER=u2demo
U2_PASSWORD=demo-no-database-behind-this
U2_ACCOUNT=DEMO

MVSTORE_DATA_PATH=./mvstore/data
PYTHONPATH=./mvstore/src

# Where the durable store lives. Leave it unset and the application runs entirely
# in memory: everything works except surviving a restart, which is a supported way
# to run the demonstration rather than a degraded one.
# ConnectionStrings__Counter=Server=127.0.0.1,1433;Database=Counter;User Id=sa;Password=...;TrustServerCertificate=True
