# Process ids written by scripts/run-dev-clean.ps1. Never committed: they are
# meaningful only to the machine that wrote them, and Article II depends on the
# file describing processes this machine actually started.
.run/

# .NET
bin/
obj/
*.user
*.suo
[Dd]ebug/
[Rr]elease/
TestResults/
*.trx

# Node
node_modules/
dist/
build/
.vite/
coverage/
*.tsbuildinfo

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Demonstration data generated by scripts/seed-demo-data.ps1. Regenerated on
# demand and large; the generator is the source of truth, not its output.
mvstore/data/

# Cypress artefacts
web/cypress/videos/
web/cypress/screenshots/
web/cypress/downloads/

# Secrets. Nothing in this repository may hold a credential (Article IX).
.env
.env.*
!.env.example
*.pfx
*.key

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.tmp

# Written by deploy/azure/provision.ps1: the names it created, which are specific
# to whoever ran it. Not secret, but not shared either -- two people provisioning
# from the same checkout would each overwrite the other's.
deploy/azure/environment.json
